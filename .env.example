# ---------------------------------------------------------------------------
# LexIndia AI — environment variables
#
# The engine runs with ZERO configuration (deterministic extractive mode,
# no API costs). Everything below is optional.
# Copy to .env (never commit .env) or set in your hosting dashboard.
# ---------------------------------------------------------------------------

# --- Server -------------------------------------------------------------
# Port for the single-process server (UI + API). Default: 8787
PORT=8787

# Path to the SQLite knowledge base. Default: <repo>/data/legal.db
# On platforms with persistent disks, point this at the mounted path.
# DB_PATH=/var/data/legal.db

# Comma/space-free single origin allowed to call the API cross-origin
# (only needed if the UI is hosted on a different domain than the API).
# Leave unset for same-origin deployments.
# CORS_ORIGIN=https://your-frontend.example.com

# --- LLM synthesis (optional; any OpenAI-compatible endpoint) -----------
# When set, answers are synthesised by the model STRICTLY from retrieved
# statutory excerpts, with post-validated citations. When unset, the
# deterministic extractive engine answers instead (no cost, no network).
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_MS=30000

# --- Embeddings (optional; enables the semantic vector channel) --------
# Uses the same OpenAI-compatible endpoint. Vectors are computed during
# `npm run ingest` and at query time. Never synthesized locally.
# EMBED_MODEL=text-embedding-3-small
# EMBED_MAX_CHUNKS=2000
